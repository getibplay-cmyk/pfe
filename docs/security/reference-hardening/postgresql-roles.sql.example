-- ALTER ROLE deployment_runtime_login CONNECTION LIMIT 30;
-- Use SCRAM, TLS verify-full, private network and explicit pg_hba source ranges.

-- Read-only checks to record with the true runtime LOGIN identity:
SELECT current_user, session_user, current_database();
SELECT rolsuper, rolcreaterole, rolcreatedb, rolbypassrls FROM pg_roles WHERE rolname = current_user;
SELECT n.nspname, c.relname, pg_get_userbyid(c.relowner) AS owner
FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = 'public' AND c.relkind IN ('r', 'p');
