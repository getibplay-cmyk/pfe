# Review and merge these NON-SECRET settings with the deployment configuration.
# This is not a replacement for the existing environment or secret manager.
APP_ENV=production
APP_NAME="SANAD PILOT"
APP_DEBUG=false
APP_URL=https://saas.example.invalid
SESSION_DRIVER=database
SESSION_COOKIE=__Host-sanad_pilot_session
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=30
SECURITY_SESSION_ABSOLUTE_MINUTES=480
AUTH_PASSWORD_TIMEOUT=900
SECURITY_MFA_REQUIRE_ADMINS=true
SECURITY_PASSWORD_BREACH_CHECK=true
SECURITY_UPLOAD_SCAN_REQUIRED=true
SECURITY_CLAMD_ENDPOINT=unix:///run/clamav/clamd.ctl
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
# Empty means no forwarded headers are trusted. Set only actual proxy IPs/CIDRs.
TRUSTED_PROXIES=
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=660
SECURITY_AI_GLOBAL_PENDING=100
SECURITY_AI_TENANT_PENDING=10
DB_CONNECTION=pgsql
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/rentfleet/postgresql-ca.pem
MAIL_MAILER=smtp
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=10
LOG_SECURITY_DAYS=14
# Provide DB identity, SMTP identity and application keys via the existing secret manager.
# Never generate a new APP_KEY as part of applying this profile.
