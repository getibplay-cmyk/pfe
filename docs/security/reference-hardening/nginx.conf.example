# TEMPLATE, not an applied configuration. Review paths, hostname and certificates.
# http context:
log_format rentfleet_minimal escape=json
  '{"time":"$time_iso8601","method":"$request_method","status":$status,'
  '"duration":$request_time,"correlation":"$sent_http_x_correlation_id"}';
# Deliberately omit URI, query, cookies and Referer: routes can contain bearer links.
limit_req_zone $binary_remote_addr zone=rentfleet_auth:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=rentfleet_connections:10m;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 443 ssl;
    server_name saas.example.invalid;
    root /srv/rentfleet/current/public;
    index index.php;
    server_tokens off;
    ssl_certificate /etc/rentfleet/tls/fullchain.pem;
    ssl_certificate_key /etc/rentfleet/tls/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 12m;
    client_body_timeout 15s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    send_timeout 30s;
    limit_conn rentfleet_connections 20;
    access_log /var/log/nginx/rentfleet-access.json rentfleet_minimal;

    # If behind an edge service, restrict both IPv4 and IPv6 at the firewall.
    # Configure set_real_ip_from with its exact published ranges, never 0.0.0.0/0.
    # real_ip_header X-Forwarded-For;
    # real_ip_recursive on;

    location ~ /\.(?!well-known/) { return 404; }
    location ~* ^/(?:vendor|storage|backups|database|node_modules|tests|scripts|config)(?:/|$) { return 404; }
    location ~* \.(?:env|sql|sqlite|bak|log|pem|key|dump)$ { return 404; }
    location ~ \.php$ { return 404; }

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /login {
        limit_req zone=rentfleet_auth burst=5 nodelay;
        try_files $uri /index.php?$query_string;
    }
    location = /forgot-password {
        limit_req zone=rentfleet_auth burst=3 nodelay;
        try_files $uri /index.php?$query_string;
    }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/rentfleet.sock;
        fastcgi_read_timeout 35s;
    }
}
