APP_NAME=RentFleet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.invalid
APP_TIMEZONE=Africa/Casablanca
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Les seeders de démonstration sont interdits en production ; cette valeur doit rester vide.
DEMO_PASSWORD=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rentfleet
DB_USERNAME=rentfleet_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
PRIVATE_DOCUMENT_MAX_KB=10240
# Pour un volume persistant externe, définir PRIVATE_DOCUMENT_ROOT hors du dépôt.

# Modules visuels consultatifs fermés par défaut. Les artefacts et empreintes restent privés.
RENTFLEET_DAMAGE_V1_ENABLED=false
DAMAGE_V1_BACKEND=rtdetrv2_s
DAMAGE_V1_PYTHON_BINARY=
DAMAGE_V1_EXECUTION_PROVIDER=CPUExecutionProvider
DAMAGE_V1_MODEL_PATH=
DAMAGE_V1_MODEL_CARD_PATH=
DAMAGE_V1_MODEL_SHA256=
DAMAGE_V1_MODEL_CARD_SHA256=
DAMAGE_V1_USER_RATE_LIMIT_PER_MINUTE=3
DAMAGE_V1_SCOPE_RATE_LIMIT_PER_HOUR=20

# ANPR hybride consultatif : désactivé par défaut, aucune action véhicule.
RENTFLEET_PLATE_HYBRID_REVIEW_ENABLED=false
PLATE_DETECTOR_PYTHON_BINARY=
PLATE_DETECTOR_DEVICE=cpu
PLATE_DETECTOR_MODEL_PATH=
PLATE_DETECTOR_MODEL_SHA256=
PLATE_DETECTOR_THRESHOLD=0.075
PLATE_DETECTOR_CROP_PADDING_RATIO=0.04
PLATE_DETECTOR_TIMEOUT_SECONDS=180
PLATE_HYBRID_PYTHON_BINARY=
PLATE_HYBRID_DEVICE=cpu
DB_QUEUE_RETRY_AFTER=660
RENTFLEET_ANOMALY_V1_ENABLED=false
ANOMALY_V1_PYTHON_BINARY=
ANOMALY_V1_USER_RATE_LIMIT_PER_MINUTE=2
ANOMALY_V1_SCOPE_RATE_LIMIT_PER_HOUR=10

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database
SCHEDULER_HEARTBEAT_MAX_AGE_MINUTES=5
OPERATIONS_QUEUE_BACKLOG_MAX=100
OPERATIONS_QUEUE_STALE_MINUTES=10
OPERATIONS_FAILED_JOBS_MAX=0
OPERATIONS_CMI_FAILURE_LOOKBACK_MINUTES=60
OPERATIONS_CMI_FAILURES_MAX=3
OPERATIONS_DISK_FREE_MIN_PERCENT=15

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
SAAS_CONTACT_EMAIL=
SAAS_INVITATION_TTL_HOURS=72
SAAS_DEFAULT_TRIAL_DAYS=14
SAAS_SELF_SERVICE_ENABLED=false
SAAS_RENEWALS_ENABLED=false
SAAS_BILLING_GRACE_DAYS=7
SAAS_INVOICE_ISSUER="BELKHIR SPACE"

SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true

VITE_APP_NAME="${APP_NAME}"
