APP_NAME=RentFleet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Casablanca

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rentfleet
DB_USERNAME=rentfleet_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_DOCUMENT_MAX_KB=10240
INTELLIGENCE_EXPORT_HMAC_KEY=
# Interpréteur de l'environnement Python où OR-Tools 9.15.6755 est installé.
# Exemple Windows : C:\Users\pc\Desktop\MDS\s4\pfe\.venv\Scripts\python.exe
INTELLIGENCE_PYTHON_BINARY=python
RENTFLEET_ANOMALY_V1_ENABLED=false
ANOMALY_V1_PYTHON_BINARY=python
ANOMALY_V1_USER_RATE_LIMIT_PER_MINUTE=2
ANOMALY_V1_SCOPE_RATE_LIMIT_PER_HOUR=10
# Runtime HGB J5 authentique (Python 3.12 + dépendances figées).
# Installer d'abord le .joblib privé exact avec :
# php artisan rentfleet:demand-model:install "C:\chemin\demand_forecast_munich_j5_v1.0.joblib"
DEMAND_FORECAST_RUNTIME_ENABLED=true
DEMAND_FORECAST_PYTHON_BINARY=python
# Facultatif : le chemin privé par défaut est storage/app/private/intelligence/models/...
# DEMAND_FORECAST_MODEL_PATH=C:\chemin\prive\demand_forecast_munich_j5_v1.0.joblib
# Modèle couleur S7 v8 : inactif par défaut, consultatif et à validation humaine.
# 1. Extraire le bundle final téléchargé depuis Drive.
# 2. php artisan rentfleet:color-v8:install "C:\chemin\S7_COLOR_V8_FINAL_DEPLOYMENT_BUNDLE"
# 3. Installer scripts/intelligence/requirements-color-v8-runtime.txt dans un environnement Python 3.12.
RENTFLEET_COLOR_V8_ENABLED=false
COLOR_V8_PYTHON_BINARY=python
COLOR_V8_EXECUTION_PROVIDER=CPUExecutionProvider
COLOR_V8_USER_RATE_LIMIT_PER_MINUTE=5
COLOR_V8_SCOPE_RATE_LIMIT_PER_HOUR=30
# Facultatif : les chemins privés par défaut sont sous storage/app/private/intelligence/models/color-v8/.
# COLOR_V8_MODEL_PATH=C:\chemin\prive\S7_COLOR_V8_FINAL.onnx
# COLOR_V8_METADATA_PATH=C:\chemin\prive\S7_COLOR_V8_FINAL_METADATA.json
# Assistant dommages EfficientNetV2-S v1.1 : artefacts privés Drive, fermé par défaut.
# 1. Monter/télécharger le dossier qualifié contenant model.onnx et model_card.json.
# 2. Renseigner localement leurs SHA-256 privés puis exécuter rentfleet:damage-v1:install.
RENTFLEET_DAMAGE_V1_ENABLED=false
DAMAGE_V1_PYTHON_BINARY=python
DAMAGE_V1_EXECUTION_PROVIDER=CPUExecutionProvider
DAMAGE_V1_MODEL_PATH=
DAMAGE_V1_MODEL_CARD_PATH=
DAMAGE_V1_MODEL_SHA256=
DAMAGE_V1_MODEL_CARD_SHA256=
DAMAGE_V1_USER_RATE_LIMIT_PER_MINUTE=3
DAMAGE_V1_SCOPE_RATE_LIMIT_PER_HOUR=20

# ANPR hybride : capture de suggestions/corrections uniquement. Laisser false
# tant que le pilote privé corrigé et la porte de qualification ne sont pas clos.
RENTFLEET_PLATE_HYBRID_REVIEW_ENABLED=false
# Environnement Torch/TorchVision séparé : checkpoint E3.2 privé, jamais commité.
PLATE_DETECTOR_PYTHON_BINARY=python
PLATE_DETECTOR_DEVICE=cpu
PLATE_DETECTOR_MODEL_PATH=
PLATE_DETECTOR_MODEL_SHA256=
PLATE_DETECTOR_THRESHOLD=0.075
PLATE_DETECTOR_CROP_PADDING_RATIO=0.04
PLATE_DETECTOR_TIMEOUT_SECONDS=180
# Environnement Paddle/PaddleOCR séparé.
PLATE_HYBRID_PYTHON_BINARY=python
PLATE_HYBRID_DEVICE=cpu
PLATE_HYBRID_USER_RATE_LIMIT_PER_MINUTE=5
PLATE_HYBRID_SCOPE_RATE_LIMIT_PER_HOUR=30
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
RESERVATION_MAXIMUM_DURATION_DAYS=365
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=420

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Facultatif hors production. Si vide, les seeders génèrent un mot de passe aléatoire.
DEMO_PASSWORD=
